policy_kwargs:
    features_extractor_class: FeatureExtractor
    features_extractor_kwargs:
        navigation_kwargs:
            d_model: 128
            num_layers: 2
            max_token: 3
            nhead: 4
        proprioception_kwargs:
            hidden_dims: [64, 128, 256]
        terrain_kwargs:
            hidden_dims: [64, 128, 256]
    net_arch:
        pi: [256, 256]
        qf: [256, 256]

unity_kwargs:
    navigation_sensor__max_token: 100

    terrain__resolution: 10

    reward__stay_success_reward: 20.0
    reward__staying_reward: 10.0
    reward__stay_success_threshold: 5.0
    reward__failure_penalty: 50.0
    reward__distance_penalty_multiplier: 0.25
    reward__action_multiplier: 10.0
    reward__jitter_penalty_multiplier: 0.1
    reward__energy_penalty_multiplier: 0.01
    reward__upright_reward_multiplier: 1.0
    reward__speed_reward_multiplier: 1.0

    phase__a_ratio: 0.0
    phase__b_ratio: 0.0
    phase__c_ratio: 0.0

    normalization__expected_max_speed: 20.0
    normalization__expected_max_distance: 10.0
    normalization__expected_max_thickness: 2.5
    normalization__expected_max_height: 2.5
